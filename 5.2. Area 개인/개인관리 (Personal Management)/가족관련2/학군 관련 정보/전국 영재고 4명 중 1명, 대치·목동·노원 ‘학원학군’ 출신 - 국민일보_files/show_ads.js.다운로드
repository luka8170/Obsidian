(function() {
	try{
		let timer;
		let isOver = false;
		let dragged;
		let pos1 = 0;
		let pos2 = 0;

		const script = document.currentScript || document.getElementById("_WiseMobViewAdsScript_");
		const src = script.src;
		const util =  function() {
			return {
				isEmpty : function(str) {
					if(typeof str == "undefined" || str == null || str == "")
						return true;
					else
						return false ;
				},
				getParameter : function(paramName) {
					const parmasLists = src.replace(/^[^\?]+\?/, '')
							.replace(/#.+$/, '')
							.split('&');
					let queries = {} , query;
					while(parmasLists.length){
						query = parmasLists.shift().split('=');
						queries[query[0]] = query[1];
					}
					return this.isEmpty(queries[paramName]) ? "" : queries[paramName];
				},
				dynamicLink : function(src,params,callback) {
					const head = document.head || document.getElementsByTagName('head')[0];
					const link = document.createElement("link");
					link.href = src;
					link.async = true;
					link.rel = "stylesheet";
					link.type = "text/css";
					head.appendChild(link);

					const img = document.createElement('img');
					img.onerror = function(){
						callback(params)
					}
					img.src = src;
					return true;
				}
			}
		}();
		const slide = function(slideWrap,width,speed,time,maxLen) {
			if (maxLen > 1)	{
				let curIndex = 0;
				return setInterval(function() {
					slideWrap.style.transition = (speed / 1000) + 's';
					slideWrap.style.transform = "translate3d(-"+width*(curIndex+1)+"px, 0px, 0px)";
					curIndex++;
					if(curIndex === maxLen){
						setTimeout(function(){
							slideWrap.style.transition = '0s';
							slideWrap.style.transform = "translate3d(0px, 0px, 0px)";
						},speed + 1)
						curIndex = 0;
					}
				},time);
			}
			return null;
		}
